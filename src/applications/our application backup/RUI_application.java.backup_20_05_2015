	/** 
	 * Handles an incoming message. If the message is a ping message replies
	 * with a pong message. Generates events for ping and pong messages.
	 * 
	 * @param msg	message received by the router
	 * @param host	host to which the application instance is attached
	 */
	@Override
	public Message handle(Message msg, DTNHost host) {
		String type = (String)msg.getProperty("type");
		if(type == null) return msg; //Not a valid msg


	/**
		Response to query msg
	*/
		if (type.equalsIgnoreCase("query") && msg.getTo() == host){
			// Send event to listeners
			super.sendEventToListeners("GotQuery", null, host);
			
			/**querying resoure and return a set of matching resources*/
			System.out.println("query for:" + msg.getProperty("queryMsg") + " from " + msg.getFrom());
			int request_in_int = Integer.parseInt( (String)msg.getProperty("queryMsg") );
			String retrieved_value_from_oppo = "";
			if(true_oppo_cache >= 1){
				retrieved_value_from_oppo = oppo_cache.get(request_in_int);
			}
			String retrieved_value_from_static = "";
			
			if(true_static_cache >= 1){
				if(static_cache.get(request_in_int) == null){
					retrieved_value_from_static = "";
				}else{
					retrieved_value_from_static = static_cache.get(request_in_int);
				}
			}
			
			
			/**selecting a subset of resources*/
			
			/**determing termination or continious of forwarding query*/

			/**modifying query*/	

			/**Routing*/

			System.out.println("msg type: " + msg.getProperty("type") + "\nretrieved_value_from_oppo:" + retrieved_value_from_oppo + "\nretrieved_value_from_static:" + retrieved_value_from_static + "\n");
		}
		
		/**
		 * Advanced version of response to query msg
		 * */
		if (type.equalsIgnoreCase("query_ad") && msg.getTo() == host){
			// Send event to listeners
			super.sendEventToListeners("GotQuery", null, host);
			
			String query_key = (String)msg.getProperty("queryMsg");
			/** check if the query_key already exist or not */
			int position_query_key = rQueue_lookup(query_key);
			if(position_query_key == -1){
				// initialize one delay queue */
				Delay_Msg temp_msg = new Delay_Msg();
				temp_msg.setQueryKey(query_key);
				temp_msg.setReceivedTime(SimClock.getTime());
				temp_msg.setTTL(ttl_for_delay_queue);
				temp_msg.setMaxToCarry(Integer.parseInt((String)msg.getProperty("maxCarriedContent")) - Integer.parseInt((String)msg.getProperty("currNumCarriedContent")));
				temp_msg.clearResourceList();
				
				//add current host to host_to_send list
				temp_msg.getHostsToSend().addHost(msg.getFrom());
				
				// add to delay queue */
				delay_queue.add(temp_msg);
			}else{
				//test code
				//System.out.println("add host to send");
				
				// add source host to host_to_send list */
				Delay_Msg temp_delay_msg = delay_queue.get(position_query_key);
				delay_queue.remove(position_query_key);
				temp_delay_msg.addHostsToSend(msg.getFrom());
				//store back
				delay_queue.add(position_query_key, temp_delay_msg);
			}
			
			/** query local cache = oppo_cache + static_cahce */
			System.out.println("query_ad for:" + msg.getProperty("queryMsg") + " from " + msg.getFrom());
			int request_in_int = Integer.parseInt( (String)msg.getProperty("queryMsg") );
			String retrieved_value_from_oppo = "";
			if(true_oppo_cache >= 1){
				retrieved_value_from_oppo = oppo_cache.get(request_in_int);
				if(retrieved_value_from_oppo.isEmpty())
					super.sendEventToListeners("oppoCacheMiss", null, host);
				else
					super.sendEventToListeners("oppoCacheHit", null, host);
			}
			
			String retrieved_value_from_static = "";
			
			if(true_static_cache >= 1){
				if(static_cache.get(request_in_int) == null){
					retrieved_value_from_static = "";
					super.sendEventToListeners("staticCacheMiss", null, host);
				}else{
					retrieved_value_from_static = static_cache.get(request_in_int);
					super.sendEventToListeners("staticCacheHit", null, host);
				}
			}
			
			
			/**selecting a subset of resources*/
			int num_of_resource_to_store = 0;
			String[] resource_to_store = new String[2];
			int curr_num_carried_content = Integer.parseInt((String)msg.getProperty("currNumCarriedContent"));
			int max_allowed_in_msg = Integer.parseInt((String)msg.getProperty("maxCarriedContent"));
			
			if(!retrieved_value_from_oppo.isEmpty() || !retrieved_value_from_static.isEmpty()){
				if(max_allowed_in_msg - curr_num_carried_content >= 2){
					if(!retrieved_value_from_oppo.isEmpty()){resource_to_store[num_of_resource_to_store] = retrieved_value_from_oppo; num_of_resource_to_store++;}
					if(!retrieved_value_from_static.isEmpty()){resource_to_store[num_of_resource_to_store] = retrieved_value_from_static; num_of_resource_to_store++;}
				}
				
				else if(max_allowed_in_msg - curr_num_carried_content == 1){
					if(!retrieved_value_from_oppo.isEmpty() && !retrieved_value_from_static.isEmpty()){
						if(rng_query_selection.nextInt(100)%2 == 0){
							//select result from oppo cache
							resource_to_store[num_of_resource_to_store] = retrieved_value_from_oppo;
						}else{
							//select result from static cache
							resource_to_store[num_of_resource_to_store] = retrieved_value_from_static;
						}
						num_of_resource_to_store ++;
					}
					else if(!retrieved_value_from_oppo.isEmpty()){
						resource_to_store[num_of_resource_to_store] = retrieved_value_from_oppo;
						num_of_resource_to_store++;
					}
					else if(!retrieved_value_from_static.isEmpty()){
						resource_to_store[num_of_resource_to_store] = retrieved_value_from_static;
						num_of_resource_to_store++;
					}
				}
			}
			
			
			/**determing termination or continious of forwarding query*/
			boolean flag_for_forward = false;
			if(num_of_resource_to_store + curr_num_carried_content < max_allowed_in_msg){flag_for_forward = true;}
			//test code
			//System.out.println("num to store " + num_of_resource_to_store + " " + curr_num_carried_content + " " + max_allowed_in_msg);
			
			
			/**modifying query*/
			if(num_of_resource_to_store > 0){
				msg.updateProperty("currNumCarriedContent", new Integer(num_of_resource_to_store + curr_num_carried_content).toString());

				int target_position = this.rQueue_lookup((String)msg.getProperty("queryMsg"));
				Delay_Msg temp_delay_msg = delay_queue.get(target_position);
				for(int i = 0; i < num_of_resource_to_store; i++){
					//store in the temp delay msg
					temp_delay_msg.addResource(resource_to_store[i]);
				}
				
				//store back
				delay_queue.remove(target_position);
				delay_queue.add(target_position, temp_delay_msg);
			}

			/** Routing */
			if(flag_for_forward){
				//add current host to visited hosts list
				msg.addNodeOnPath(host);
				//forward to other nodes except visited
				boolean flag_forwarded = false;
				List<DTNHost> visited_hosts = msg.getHops();
				World w = SimScenario.getInstance().getWorld();
				for(int destAddr = destMin; destAddr < destMax; destAddr++){
					DTNHost h = w.getNodeByAddress(destAddr);
					if(h != null && !visited_hosts.contains(h)){
						msg.setFrom(host);
						msg.setTo(h);
						host.createNewMessage(msg);
						
						flag_forwarded = true;
						//test code
						//System.out.println("msg forward" + msg + " to " + h);
					}
				}
				
				//in case there is nobody to forward
				if(!flag_forwarded){
					System.out.println(host + ":Nothing found, drop package");
				}
				
			}
			else{
				/*
				//response back
				///get host_to_send list
				int target_position = this.rQueue_lookup((String)msg.getProperty("queryMsg"));
				Delay_Msg temp_delay_msg = delay_queue.get(target_position);
				List<DTNHost> hosts_to_send = temp_delay_msg.getHostsToSend().getHostToSendList();
				for(DTNHost h:hosts_to_send){
					Message response = new Message(host, h, "queryResponse" + SimClock.getIntTime() + "-" + host.getAddress(), this.getQueryResponseSize());
					response.addProperty("type", "queryResponse");
					response.addProperty("queryMsg", (String)msg.getProperty("queryMsg"));
					response.addProperty("content", temp_delay_msg.getResourceList().toString());
					response.setAppID(APP_ID);
					host.createNewMessage(response);
				}
				*/
			}

			//System.out.println("msg type: " + msg.getProperty("type") + "\nretrieved_value_from_oppo:" + retrieved_value_from_oppo + "\nretrieved_value_from_static:" + retrieved_value_from_static + "\n");
		
		}
		
		
		
		
		/** parse response */
		if (type.equalsIgnoreCase("queryResponse") && msg.getTo() == host){
			String response_msg = "";
			String query_key_of_response = (String)msg.getProperty("queryMsg");
			
			// Send event to listeners
			super.sendEventToListeners("GotResponse", query_key_of_response, host);
			
			if(msg.getProperty("content") == null)
				response_msg = "Nothing found";
			else{
				response_msg = (String)msg.getProperty("content");
				//check whether there is a delay_msg in delay_queue waiting for it or not
				int target_position_for_response = rQueue_lookup(query_key_of_response);
				if( target_position_for_response != -1){
				///if yes, store the response into resource list. PS: when the num of resource get to the max value, the update function below is responsiable for sending msg to the former host which are recorded in host_to_send list;
					Delay_Msg temp_msg = delay_queue.get(target_position_for_response);
					temp_msg.addResource(response_msg);
					////store back
					delay_queue.set(target_position_for_response, temp_msg);
					

					////store successful query into oppo_cache and don't clean up the delay_queue
					if(oppo_cache.get(Integer.parseInt(query_key_of_response)) == null)
						oppo_cache.set(Integer.parseInt(query_key_of_response), response_msg);
				}
				else{
				///else, the time is up. Drop the packet
					System.out.println(host + ": query for " + query_key_of_response + " is time up. Drop it.");
				}
				
			}
			
			
			System.out.println(host + ": got " + response_msg + " for " + query_key_of_response + "\n");
		}
		
		

		return msg;
	}

	/** 
	 * Draws a random host from the destination range
	 * 
	 * @return host
	 */
	private DTNHost randomHost() {
		int destaddr = 0;
		if (destMax == destMin) {
			destaddr = destMin;
		}
		destaddr = destMin + rng.nextInt(destMax - destMin);
		World w = SimScenario.getInstance().getWorld();
		
		return w.getNodeByAddress(destaddr);
	}
	
