	/** 
	 *
	 * 
	 * @param host to which the application instance is attached
	 */
	@Override
	public void update(DTNHost host) {
		if(this.mode == 1){
			/** generate msg */
			double curTime = SimClock.getTime();
			if (curTime - this.lastPing >= this.interval) {
				if( curGenerated < num_of_msg_to_generate){
					curGenerated ++;
					
					if(rng_query == null){
						//accept the num in the name of host to act as an parameter to generate query
						int seed_from_host = Integer.parseInt(host.toString().substring(1)) + 1;
						rng_query = new Random(seed_for_query + seed_from_host);
					}
					
					//check does current host itself already has the resource or not
					int query_key = -1;
					while(true){
						query_key = query_range_Min + rng_query.nextInt(query_range_Max - query_range_Min);
						boolean flag_for_reg = false;
						if(static_cache != null){
							if(static_cache.get(query_key) != null && !static_cache.get(query_key).isEmpty()){
								flag_for_reg = true;
								//System.out.println("static true:" + static_cache.get(query_key));
							}
						}
						
						if(oppo_cache != null){
							if(oppo_cache.get(query_key) != null && !oppo_cache.get(query_key).isEmpty()){
								flag_for_reg = true;
								//System.out.println("oppo true:" + oppo_cache.get(query_key));
							}
						}
/*		
						//test code
						System.out.println("regenerate:" + query_key);
						
						try{
							Thread.sleep(2000);
						}catch(InterruptedException e){
							
						}
	*/					
						if(flag_for_reg == false)
							break;
					}
					
					/** broadcast the query msg to all the host expect the sender */
					boolean flag_for_sent_once = false;
					List<DTNHost> hosts = SimScenario.getInstance().getWorld().getHosts();
					for(DTNHost destHost:hosts){
						if(destHost != null && destHost != host){
							// Time to send a query msg
							Message m = new Message(host, destHost, "query_ad" +
									SimClock.getIntTime() + "-" + host.getAddress(),
									getPingSize());
							m.addProperty("type", "query_ad");
							m.addProperty("queryMsg", new Integer(query_key).toString());
							m.addProperty("maxCarriedContent", new Integer(max_carried_content).toString());
							m.addProperty("currNumCarriedContent", "0");
							m.setAppID(APP_ID);
							host.createNewMessage(m);
							
							if(flag_for_sent_once == false){
								super.sendEventToListeners("SentQuery", (String)m.getProperty("queryMsg"), host);
								query_record.put(Integer.parseInt((String)m.getProperty("queryMsg")), 0);
								System.out.println(host + " query for [" + (String)m.getProperty("queryMsg") + "]");
							}
							flag_for_sent_once = true;
						}
					}
					
					//test code
					//System.out.println(host + " query for [" + query_key + "] to " + hosts);
					
					this.lastPing = curTime;
				}
			}
		}
		
		/** update delay_queue: checking every delay_msg in delay_queue */
		List<Delay_Msg> to_set_false = new ArrayList<Delay_Msg>();
		List<Delay_Msg> to_delete = new ArrayList<Delay_Msg>();
		for(Delay_Msg delay_msg:delay_queue){
			double currTime = SimClock.getTime();
			//check whether time is up or not
			
			//right now don't drop but we should uncomment the following code in the later advanced section.
			double time_diff = delay_msg.getReceivedTime() + delay_msg.getTTL() - currTime;
			//double time_diff = 1;
			
			if(time_diff > 0){
				///if not, check whether the resoure_list is full
				if(delay_msg.getResourceList().size() != 0){
					if(delay_msg.getMaxToCarry() <= delay_msg.getResourceList().size() || time_diff < 100){
						////if yes, check whether it is sent already
						if(delay_msg.getValid() == true){
							
							//test code
							//System.out.println(host + ": send back to " + delay_msg.getHostsToSend().getHostToSendList());
							
							/////send response msg back to the hosts in host_to_send list
							List<DTNHost> hosts_to_send = delay_msg.getHostsToSend().getHostToSendList();
							for(DTNHost hts:hosts_to_send){
								if(hts != host){
									Message response = new Message(host, hts, "queryResponse" + SimClock.getIntTime() + "-" + host.getAddress(), this.getQueryResponseSize());
									response.addProperty("type", "queryResponse");
									response.addProperty("queryMsg", delay_msg.getQueryKey());
									String response_content_str = "";
									for(String s:delay_msg.getResourceList()){
										response_content_str += s + ",";
									}
									response.addProperty("content", response_content_str);
									response.setAppID(APP_ID);
									host.createNewMessage(response);
									
									//test code
									System.out.println(host + ": response back to " + hts + " for msg: [" + delay_msg.getQueryKey() + "]");
								}
								
							}
							/////set the valid flag of delay_msg to false but it is still valid in oppo_cache
							//delay_msg.setValid(false);
							to_set_false.add(delay_msg);
						}
						
					}
					else{	
						////else, continue to next delay_msg;
						continue;
					}
				}
				
				else{
					continue;
				}
				
				
			}
			else{
				//test code
				//System.out.println(host + ":" + delay_msg + " time is up " + time_diff);
				
				///else delete the delay_msg in delay_queue and remove corresponding reference in oppo_cache
				//delay_queue.remove(delay_msg);
				to_delete.add(delay_msg);
			}
		}
		
		
		///set valid to false
		for(Delay_Msg delay_msg : to_set_false){
			Delay_Msg temp_msg = delay_msg;
			temp_msg.setValid(false);
			delay_queue.remove(delay_msg);
			delay_queue.add(temp_msg);
		}
		///delete delay_msg in delay_queue
		for(Delay_Msg delay_msg : to_delete){
			delay_queue.remove(delay_msg);
		}
		
		
	}
	
	
	public int rQueue_lookup(String query_key){
		int i = 0;
		for(Delay_Msg msg: this.delay_queue){
			if(msg.getQueryKey().equals(query_key)){
				return i;
			}
			i++;
		}
		return -1;
	}
	

